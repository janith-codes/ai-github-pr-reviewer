# ---------------------------------------------------------------------------
# AI GitHub PR Reviewer - example environment file
#
# Copy to `.env` and adjust the values. Never commit a real `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# ----------------------------- Database ------------------------------------
# Consumed by Prisma (apps/api) and must match the docker-compose credentials.
# The container publishes PostgreSQL on 5433 rather than the default 5432 so it
# cannot clash with a PostgreSQL server installed directly on the host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_pr_reviewer?schema=public"

# Credentials used by the docker-compose PostgreSQL service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_pr_reviewer
POSTGRES_PORT=5433

# ------------------------------- API ---------------------------------------
# Port the NestJS API listens on.
API_PORT=4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ------------------------------- Web ---------------------------------------
# Base URL of the API, inlined into the Next.js client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
